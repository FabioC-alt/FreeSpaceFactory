---
import { SITE, NAV_LINKS } from '../lib/constants';
import { u } from '../lib/url';

const year = new Date().getFullYear();
---

<footer class="border-t border-ink/10 bg-ink text-paper">
  <div class="container-page grid gap-10 py-16 sm:grid-cols-2 md:grid-cols-3">
    <div>
      <p class="font-serif text-lg">{SITE.name}</p>
      <p class="mt-3 max-w-xs text-sm text-paper/70">{SITE.tagline}</p>
    </div>

    <nav aria-label="Mappa del sito">
      <p class="text-sm font-medium uppercase tracking-wide text-paper/50">Sito</p>
      <ul class="mt-3 space-y-2 text-sm">
        {
          NAV_LINKS.map((link) => (
            <li>
              <a href={u(link.href)} class="text-paper/80 transition-colors hover:text-paper">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div>
      <p class="text-sm font-medium uppercase tracking-wide text-paper/50">Contatti</p>
      <ul class="mt-3 space-y-2 text-sm text-paper/80">
        <li>
          <a href={`mailto:${SITE.email}`} class="hover:text-paper">{SITE.email}</a>
        </li>
        <li>{SITE.city}</li>
      </ul>
    </div>
  </div>

  <div class="border-t border-paper/10 py-6">
    <p class="container-page text-xs text-paper/50">
      &copy; {year} {SITE.name}. Tutti i diritti riservati.
    </p>
  </div>
</footer>
