---
import { SITE, NAV_LINKS } from '../lib/constants';
import { u } from '../lib/url';

const year = new Date().getFullYear();
---

<footer class="border-t border-ink/10 bg-ink text-paper">
  <div class="container-page grid gap-10 py-16 sm:grid-cols-2 md:grid-cols-3">
    <div>
      <p class="font-serif text-lg">{SITE.name}</p>
      <p class="mt-3 max-w-xs text-sm text-paper/70">{SITE.tagline}</p>
    </div>

    <nav aria-label="Mappa del sito">
      <p class="text-sm font-medium uppercase tracking-wide text-paper/50">Sito</p>
      <ul class="mt-3 space-y-2 text-sm">
        {
          NAV_LINKS.map((link) => (
            <li>
              <a href={u(link.href)} class="text-paper/80 transition-colors hover:text-paper">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div>
      <p class="text-sm font-medium uppercase tracking-wide text-paper/50">Contatti</p>
      <ul class="mt-3 space-y-2 text-sm text-paper/80">
        <li>
          <a href={`mailto:${SITE.email}`} class="hover:text-paper">{SITE.email}</a>
        </li>
        <li>{SITE.city}</li>
        <li>
          <a
            href={SITE.instagram}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 hover:text-paper"
          >
            <svg class="h-3.5 w-3.5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
            <span>Instagram</span>
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="border-t border-paper/10 py-6">
    <p class="container-page text-xs text-paper/50">
      &copy; {year} {SITE.name}. Tutti i diritti riservati.
    </p>
  </div>
</footer>
