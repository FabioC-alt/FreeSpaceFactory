---
import { SITE, NAV_LINKS } from '../lib/constants';
import { u } from '../lib/url';

const currentPath = Astro.url.pathname;

function isActive(href: string) {
  const resolved = u(href);
  if (href === '/') return currentPath === resolved;
  return currentPath.startsWith(resolved);
}
---

<header class="sticky top-0 z-40 border-b border-ink/10 bg-paper/95 backdrop-blur">
  <div class="container-page flex h-20 items-center justify-between">
    <a href={u('/')} class="flex shrink-0 items-center" aria-label={SITE.name}>
      <img src={u('images/logo/logo.png')} alt={SITE.name} class="h-10 w-auto sm:h-12" width="580" height="196" />
    </a>

    <nav aria-label="Navigazione principale" class="hidden xl:block">
      <ul class="flex items-center gap-6 text-sm font-medium uppercase tracking-wide">
        {
          NAV_LINKS.map((link) => (
            <li>
              <a
                href={u(link.href)}
                aria-current={isActive(link.href) ? 'page' : undefined}
                class:list={[
                  'transition-colors hover:text-brand-600',
                  isActive(link.href) && 'text-brand-600',
                ]}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <details class="xl:hidden">
      <summary class="cursor-pointer list-none rounded border border-ink/20 px-3 py-2 text-sm">
        Menu
      </summary>
      <nav aria-label="Navigazione mobile" class="absolute inset-x-0 top-20 border-b border-ink/10 bg-paper">
        <ul class="container-page flex flex-col gap-1 py-4 text-sm font-medium uppercase tracking-wide">
          {
            NAV_LINKS.map((link) => (
              <li>
                <a href={u(link.href)} class="block py-2">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </details>
  </div>
</header>
