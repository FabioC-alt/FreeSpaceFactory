---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { u } from '../../lib/url';
---

<BaseLayout
  title="Messaggio inviato"
  description="Grazie per averci scritto, ti risponderemo il prima possibile."
  noindex
>
  <section class="container-page flex min-h-[60vh] flex-col items-center justify-center text-center">
    <p class="text-sm font-medium uppercase tracking-wide text-brand-600">Messaggio inviato</p>
    <h1 class="mt-4 font-serif text-4xl sm:text-5xl">Grazie per averci scritto</h1>
    <p class="mt-4 max-w-md text-ink/70">Ti risponderemo il prima possibile via email.</p>
    <a href={u('/')} class="btn-primary mt-8">Torna alla home</a>
  </section>
</BaseLayout>
