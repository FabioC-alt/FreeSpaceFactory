---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../lib/constants';
import { u } from '../../lib/url';

const thankYouUrl = new URL(u('/contatti/grazie/'), Astro.site || SITE.url).toString();
---

<BaseLayout
  title="Contatti"
  description="Contatta lo studio di architetti Free Space Factory a Roma per informazioni o richieste di preventivo."
>
  <section class="container-page py-20 sm:py-28">
    <h1 class="font-serif text-4xl sm:text-5xl">Contatti</h1>
    <p class="mt-4 max-w-xl text-ink/70">
      Raccontaci il tuo progetto: ti rispondiamo via email il prima possibile.
    </p>

    <div class="mt-14 grid gap-16 lg:grid-cols-2">
      <form
        action="https://api.web3forms.com/submit"
        method="POST"
        class="space-y-6"
      >
        <input type="hidden" name="access_key" value={SITE.web3formsAccessKey} />
        <input type="hidden" name="subject" value="Nuovo messaggio dal sito Free Space Factory" />
        <input type="hidden" name="redirect" value={thankYouUrl} />
        <input type="text" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" />

        <div>
          <label for="name" class="text-sm font-medium uppercase tracking-wide text-ink/50">
            Nome
          </label>
          <input
            id="name"
            name="name"
            type="text"
            required
            class="mt-2 w-full border border-ink/20 bg-transparent px-4 py-3 text-ink outline-none focus:border-brand-500"
          />
        </div>

        <div>
          <label for="email" class="text-sm font-medium uppercase tracking-wide text-ink/50">
            Email
          </label>
          <input
            id="email"
            name="email"
            type="email"
            required
            class="mt-2 w-full border border-ink/20 bg-transparent px-4 py-3 text-ink outline-none focus:border-brand-500"
          />
        </div>

        <div>
          <label for="message" class="text-sm font-medium uppercase tracking-wide text-ink/50">
            Messaggio
          </label>
          <textarea
            id="message"
            name="message"
            rows="5"
            required
            class="mt-2 w-full border border-ink/20 bg-transparent px-4 py-3 text-ink outline-none focus:border-brand-500"
          ></textarea>
        </div>

        <button type="submit" class="btn-primary">Invia messaggio</button>
      </form>

      <div>
        <div>
          <h2 class="text-sm font-medium uppercase tracking-wide text-ink/50">Email</h2>
          <a href={`mailto:${SITE.email}`} class="mt-2 block font-serif text-2xl hover:text-brand-600">
            {SITE.email}
          </a>
        </div>
        <div class="mt-10">
          <h2 class="text-sm font-medium uppercase tracking-wide text-ink/50">Sede</h2>
          <p class="mt-2 font-serif text-2xl">{SITE.city}</p>
        </div>
        <div class="mt-10">
          <h2 class="text-sm font-medium uppercase tracking-wide text-ink/50">Instagram</h2>
          <p class="mt-2 text-ink/70">Segui i nostri progetti e le fasi di cantiere.</p>
          <div class="mt-4">
            <a
              href={SITE.instagram}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-secondary inline-flex items-center gap-2.5"
            >
              <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
              </svg>
              <span>@freespacefactory</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
