---
import BaseLayout from '../layouts/BaseLayout.astro';
import { u } from '../lib/url';
---

<BaseLayout title="Pagina non trovata" description="La pagina richiesta non è stata trovata." noindex>
  <section class="container-page flex min-h-[60vh] flex-col items-center justify-center text-center">
    <p class="text-sm font-medium uppercase tracking-wide text-ink/50">Errore 404</p>
    <h1 class="mt-4 font-serif text-4xl sm:text-5xl">Pagina non trovata</h1>
    <p class="mt-4 max-w-md text-ink/70">
      La pagina che cerchi non esiste più o è stata spostata.
    </p>
    <a href={u('/')} class="btn-primary mt-8">Torna alla home</a>
  </section>
</BaseLayout>
